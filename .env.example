# Copy to apps/web/.env.local (never commit real keys).

# Optional — live Gemini. Without a key the app runs fully offline with
# deterministic, grounded templates (the UI shows "Demo AI").
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# GEMINI_THINKING_LEVEL=LOW

# Force offline templates even when a key is set (e.g. flaky venue Wi-Fi).
# AI_MODE=demo

# Secret for the commit–reveal ballot seeds. Set a long random value in production.
DRAW_SECRET=change-me-to-a-long-random-string
