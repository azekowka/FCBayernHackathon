{
  "name": "@fcb/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Gemini adapter + deterministic demo provider. Language only — every decision and number comes from @fcb/core.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
